# --- Server -----------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Public URL of this server (used to build absolute file URLs and links)
PUBLIC_URL=http://localhost:8080
# Where the SQLite database and uploaded files live
DATA_DIR=./data
# Comma separated origins allowed for CORS (the native app needs none; the web version does)
CORS_ORIGINS=*

# --- First admin (created on first start if no user exists) ------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=עורך העלון

# --- Registration -----------------------------------------------------------
# pending: new users wait for an editor to approve them (default, like the site)
# active:  new users are active immediately
NEW_USER_STATUS=pending

# --- Push notifications (Firebase Cloud Messaging) ---------------------------
# Path to a Firebase service-account JSON. Leave empty to log pushes instead of sending.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# --- Email (optional, for password reset links) ------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="עלון נצר-סרני <alon@example.com>"

# --- One-time import from Base44 (only for `npm run import:base44`) ----------
BASE44_APP_ID=
BASE44_API_KEY=
BASE44_SERVER_URL=https://base44.app
# Map of Base44 entity names -> app content types (JSON). Adjust to the real names.
BASE44_ENTITY_MAP={"Article":"article","Flash":"flash","Event":"event","Greeting":"greeting","Issue":"issue"}
